# Developer Portal -> your app -> OAuth2 tab
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret

# Developer Portal -> your app -> Bot tab -> Reset/copy Token
# The bot MUST already be a member of DISCORD_GUILD_ID.
DISCORD_BOT_TOKEN=your_bot_token

# Right-click the target server in Discord (Developer Mode on) -> Copy Server ID
DISCORD_GUILD_ID=your_guild_id

# Must EXACTLY match a Redirect URI registered in the Developer Portal
DISCORD_REDIRECT_URI=http://localhost:8080/callback

# Any random string — used to sign NiceGUI's session cookie
NICEGUI_STORAGE_SECRET=some-random-string
