# Developer Portal -> your app -> OAuth2 tab
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Developer Portal -> your app -> Bot tab -> Reset/copy Token
# The bot MUST already be a member of each DISCORD_GUILD_ID that we want to verify user membership in.
DISCORD_BOT_TOKEN=

# Must EXACTLY match a Redirect URI registered in the Developer Portal
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Any random string — used to sign NiceGUI's session cookie
# generated with `uv run python -c "import secrets; print(secrets.token_urlsafe(32))"`
STORAGE_SECRET=
